.env
.venv/
venv2/
scratch/

# OS and interpreter artifacts. .DS_Store in particular used to be hashed into
# data/manifest.json, so Finder touching a directory changed the manifest hash
# and tripped the store integrity guard.
.DS_Store
**/.DS_Store
__pycache__/
**/__pycache__/
*.pyc

runs/cache/
tmp_data_*/

# Ablation replays write their own copies; only the real artifacts are tracked.
runs/a1_store_data*.db
runs/a8_store_data*.db
runs/a1_stage2_seed*.json
runs/a8_stage2_seed*.json
detect/eval_stage2_tmp.py
detect/eval_stage2_a1_tmp.py
detect/eval_stage2_a8_tmp.py

# Model-scoped replication raw logs: 262MB across 64k files. Archived per run
# as runs/raw_{model}_{condition}_rs{seed}.tar.gz instead, matching the existing
# raw_*.tar.gz convention. Untar into runs/raw/ to re-run verify_runs.py.
runs/raw/deepseek-chat_*/
runs/raw/gpt-5.6-luna_*/
runs/raw/claude-sonnet-5_*/

# Sweep console logs
runs/*.log
